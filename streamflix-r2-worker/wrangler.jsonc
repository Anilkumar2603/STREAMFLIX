{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamflix-r2-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true,

  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "streamflix-media",
      "remote": true
    }
  ]
}